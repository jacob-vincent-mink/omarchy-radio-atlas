#!/bin/bash
set -euo pipefail

project_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)

jq -e '
  .schemaVersion == 2
  and .id == "akshar.radio-atlas"
  and .runtime.qml == "RadioAtlas.qml"
  and .runtime.surfaceQml == {"atlas":"RadioAtlas.qml","barWidget":"BarWidget.qml"}
  and .surfaces.atlas.role == "desktop-overlay"
  and .surfaces.barWidget.role == "bar-embedded"
' "$project_dir/manifest.json" >/dev/null

bash -n "$project_dir/radio-fetch" "$project_dir/radio-player" \
  "$project_dir/radio-sandbox" "$project_dir/radio-session" "$project_dir/radio-state" \
  "$project_dir/tests/fixtures/"*
luac -p "$project_dir/radio-status.lua"
node "$project_dir/tests/model.test.mjs"
node --test "$project_dir/tests/secure-v2.test.mjs"
python3 "$project_dir/tests/proxy.test.py"
