#!/usr/bin/python3
"""Installed, reviewed host entry point; no worker-selected commands or sockets."""
import json
import os
from pathlib import Path
import re
import stat
import sys
import time


def selection(data):
  """Read the one shared input without following worker-created symlinks."""
  parts = Path(data).parts
  if not os.path.isabs(data) or ".." in parts:
    raise ValueError("Invalid data path")
  fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
  try:
    for part in (*parts[1:], "radio-selection.json"):
      child = os.open(part, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
      os.close(fd)
      fd = child
    info = os.fstat(fd)
    if not stat.S_ISREG(info.st_mode) or info.st_size > 4194304:
      raise ValueError("Invalid station selection")
    with os.fdopen(os.dup(fd), "rb") as stream:
      raw = stream.read(4194305)
    if len(raw) > 4194304:
      raise ValueError("Station selection is too large")
    rows = json.loads(raw)
    if not isinstance(rows, list) or not 1 <= len(rows) <= 500:
      raise ValueError("Invalid station selection")
    for row in rows:
      if not isinstance(row, dict) or not isinstance(row.get("name"), str):
        raise ValueError("Invalid station")
      url = row.get("url", "")
      if not isinstance(url, str) or not re.fullmatch(r"https?://[^\s\x00-\x1f\x7f]+", url, re.I):
        raise ValueError("Unsafe stream URL")
    return rows
  finally:
    os.close(fd)


def main():
  if len(sys.argv) < 3:
    raise ValueError("Expected approved data and action")
  data, action, *args = sys.argv[1:]
  if action in ("serve", "volume"):
    if len(args) != 1 or not re.fullmatch(r"0|[1-9][0-9]?|100", args[0]):
      raise ValueError("Volume must be an integer from 0 to 100")
  elif action == "play":
    if len(args) != 1 or not re.fullmatch(r"[0-9A-Fa-f-]{20,64}", args[0]):
      raise ValueError("Invalid station ID")
  elif action not in ("status", "toggle", "next", "previous", "mute", "stop") or args:
    raise ValueError("Unsupported player action")

  # These directories are host-owned, never mounted writable in the worker.
  runtime = Path(os.environ["XDG_RUNTIME_DIR"]) / "radio-atlas-ward"
  player = runtime / "omarchy-radio-atlas"
  status_dir = Path(os.environ.get("XDG_STATE_HOME", str(Path.home() / ".local/state"))) / "radio-atlas-ward/status"
  for directory in (runtime, player, status_dir):
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
  if action == "play":
    rows = selection(data)
    if not any(row.get("uuid") == args[0] for row in rows):
      raise ValueError("Station is not in the selection")
    target = player / "play-selection.json"
    temporary = target.with_suffix(".next")
    temporary.write_text(json.dumps(rows) + "\n")
    temporary.replace(target)
    deadline = time.monotonic() + 3
    while not (player / "mpv.sock").is_socket() and time.monotonic() < deadline:
      time.sleep(0.02)
    args.append("selection")
  os.environ.update(
    RADIO_ATLAS_RUNTIME_DIR=str(player),
    RADIO_ATLAS_DATA_HOME=str(runtime / "data"),
    RADIO_ATLAS_SUPERVISED="true",
    RADIO_ATLAS_STATUS_FILE=str(status_dir / "status.json"),
  )
  # Installed alongside this CLI by the user, never taken from a plugin bundle.
  os.execv("/usr/bin/bash", ["bash", "/usr/local/lib/radio-atlas-ward/radio-player", action, *args])


if __name__ == "__main__":
  os.umask(0o077)
  try:
    main()
  except (OSError, ValueError) as error:
    print(f"Radio Atlas: {error}", file=sys.stderr)
    sys.exit(2)
