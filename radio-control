#!/bin/bash
set -euo pipefail
umask 077

# All state, player IPC and decoder processes are sandbox-local.
script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export RADIO_ATLAS_SUPERVISED=true
action=${1:-status}
shift || true

if [[ $action == "session" ]]; then
  volume=$("$script_dir/radio-state" get | jq -r '.volume // 70 | round')
  exec "$script_dir/radio-player" serve "$volume"
else
  if [[ $action == "play" ]]; then
    for _ in {1..150}; do
      [[ -S $XDG_RUNTIME_DIR/omarchy-radio-atlas/mpv.sock ]] && break
      sleep 0.02
    done
  fi
  "$script_dir/radio-player" "$action" "$@"
  if [[ $action == "play" && ${1:-} =~ ^[0-9A-Fa-f-]{20,64}$ ]]; then
    curl --fail --silent --max-time 4 --proto '=https' \
      --user-agent 'Radio Atlas/0.1.4 (https://github.com/AksharP5/omarchy-radio-atlas)' \
      "https://all.api.radio-browser.info/json/url/$1" >/dev/null 2>&1 || true
  fi
fi
