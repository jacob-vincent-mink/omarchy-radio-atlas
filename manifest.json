{
  "schemaVersion": 2,
  "id": "akshar.radio-atlas",
  "name": "Radio Atlas",
  "version": "0.2.0",
  "author": "Akshar Patel",
  "license": "MIT",
  "description": "Explore live radio on a rotatable globe and play stations through Omarchy's media controls.",
  "homepage": "https://github.com/AksharP5/omarchy-radio-atlas",
  "repository": "https://github.com/AksharP5/omarchy-radio-atlas",
  "keywords": ["radio", "world", "globe", "music", "mpris"],
  "runtime": {
    "apiVersion": 1,
    "qml": "RadioAtlas.qml",
    "surfaceQml": {"atlas": "RadioAtlas.qml", "barWidget": "BarWidget.qml"}
  },
  "surfaces": {
    "atlas": {"role": "desktop-overlay", "maximumWidth": 1440, "maximumHeight": 1000, "maximumFramesPerSecond": 60, "keyboardFocus": "after-gesture", "inputRegions": "dynamic-bounded"},
    "barWidget": {"role": "bar-embedded", "maximumWidth": 72, "maximumHeight": 64, "maximumFramesPerSecond": 30, "defaultSection": "left", "inputRegions": "dynamic-bounded"}
  },
  "permissions": {
    "required": [
      {"capability": "network.fetch", "definitionGeneration": 1, "definitionDigest": "fd879fab2d17f35dcb56b0d3426ffc436a5c46d9dd717e6ca0a03ee0accaf62b", "operations": ["fetch"], "origins": ["https://all.api.radio-browser.info"], "methods": ["GET"], "reason": "Find public radio stations without exposing general network access"}
    ],
    "optional": [
      {"capability": "media.play-stream", "definitionGeneration": 1, "definitionDigest": "40709dc8191bee3db0a20c0ab1f28ddd729175eecb4c333d09b45687ae47950b", "operations": ["control", "play"], "sourceHandles": ["network.fetch"], "controls": ["pause", "stop", "mute", "volume", "status"], "reason": "Play only activation-bound station handles through a host-owned media session; browsing remains available when denied"},
      {"capability": "storage.private", "quotaBytes": 1048576, "itemBytes": 49152, "reason": "Persist favorites, listening history, and volume; without it these remain available for this session"}
    ]
  }
}
