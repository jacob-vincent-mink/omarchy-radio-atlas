{
  "schemaVersion": 2,
  "id": "akshar.radio-atlas",
  "name": "Radio Atlas",
  "version": "0.2.0-secure-preview",
  "description": "Secure-runtime port preserving the interactive QML globe while moving authority behind typed providers.",
  "runtime": {
    "apiVersion": 1,
    "qml": "RadioAtlas.qml",
    "surfaceQml": {
      "atlas": "RadioAtlas.qml",
      "barWidget": "BarWidget.qml"
    }
  },
  "surfaces": {
    "atlas": {"role": "desktop-overlay", "maximumWidth": 1440, "maximumHeight": 1000, "maximumFramesPerSecond": 60, "keyboardFocus": "after-gesture", "lockScreenVisible": false, "inputRegions": "dynamic-bounded"},
    "barWidget": {"role": "bar-embedded", "maximumWidth": 72, "maximumHeight": 64, "maximumFramesPerSecond": 30, "defaultSection": "left", "inputRegions": "dynamic-bounded"}
  },
  "permissions": {
    "required": [
      {"capability": "network.fetch", "definitionGeneration": 1, "definitionDigest": "6ab72b29cb9a561eab8e85b5582a637d5e9f7c4ff74f65002e9465ba2dc5b6a9", "operations": ["fetch"], "origins": ["https://all.api.radio-browser.info"], "methods": ["GET"], "reason": "Find public radio stations without exposing general network access"},
      {"capability": "media.play-stream", "definitionGeneration": 1, "definitionDigest": "40709dc8191bee3db0a20c0ab1f28ddd729175eecb4c333d09b45687ae47950b", "operations": ["control", "play"], "sourceCapabilities": ["network.fetch"], "controls": ["pause", "stop", "mute", "volume", "status"], "reason": "Play only activation-bound station handles through a host-owned media session"},
      {"capability": "storage.private", "quotaBytes": 1048576, "itemBytes": 4096, "reason": "Save bounded favorites, history, and volume"}
    ],
    "optional": []
  }
}
